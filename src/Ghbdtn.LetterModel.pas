function EnglishIndex(C: Char): Integer;
begin
  if (C >= 'a') and (C <= 'z') then
    Result := Ord(C) - Ord('a')
  else if C = '''' then
    Result := 26
  else
    Result := EnglishLetters;
end;

function RussianIndex(C: Char): Integer;
begin
  if C = 'ё' then
    C := 'е';
  if (C >= 'а') and (C <= 'я') then
    Result := Ord(C) - Ord('а')
  else if C = '-' then
    Result := 32
  else
    Result := RussianLetters;
end;

function ModelScore(const AWord, ACosts: string; ALetters: Integer;
  ARussian: Boolean): Integer;
var
  I, Rows, Width, Prev2, Prev, Next, Total: Integer;
begin
  if AWord = '' then
    Exit(0);
  Rows := ALetters + 2;
  Width := ALetters + 2;
  Prev2 := 0;
  Prev := 0;
  Total := 0;
  for I := 1 to Length(AWord) + 1 do
  begin
    if I > Length(AWord) then
      Next := ALetters + 1
    else if ARussian then
      Next := RussianIndex(AWord[I])
    else
      Next := EnglishIndex(AWord[I]);
    Inc(Total, Ord(ACosts[(Prev2 * Rows + Prev) * Width + Next + 1]) - CostBase);
    Prev2 := Prev;
    Prev := Next + 1;
  end;
  Result := -Round(Total / (Length(AWord) + 1));
end;

function LetterModelScore(const ALower: string; ALang: TLangKind): Integer;
begin
  if ALang = lkEN then
    Result := ModelScore(ALower, EnglishCosts, EnglishLetters, False)
  else
    Result := ModelScore(ALower, RussianCosts, RussianLetters, True);
end;

